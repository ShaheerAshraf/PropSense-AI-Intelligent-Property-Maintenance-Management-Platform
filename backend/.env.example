# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/property_db?schema=public"

# Auth (JWT)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Supabase Storage (private bucket for maintenance images)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Prefer SUPABASE_SERVICE_ROLE_KEY; SUPABASE_SECRET_KEY is also accepted
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# SUPABASE_SECRET_KEY=
SUPABASE_BUCKET="maintenance-images"
SUPABASE_SIGNED_URL_EXPIRES_IN="3600"

# Google Gemini (AI analysis)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
